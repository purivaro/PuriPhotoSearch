{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puri Photo Search",
  "version": "2.0.0-alpha.4",
  "identifier": "com.purivaro.puriphotosearch2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Puri Photo Search",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: puri: http://puri.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: http://localhost:1420; img-src 'self' data: blob: puri: http://puri.localhost http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NTIxOEU0MjFERUY5NUUKUldSZStkNGg1QmhTVlg5K3ZYT1A5NGVVVGlpVjh6dFI3WFFZVnVWYTJPYWVLZWJyN0FDbEpCZ1YK",
      "endpoints": ["https://raw.githubusercontent.com/purivaro/PuriPhotoSearch/updates/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Photography",
    "shortDescription": "ค้นหารูปคนที่ต้องการ จากกิจกรรมในเครื่อง",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.4" }
  }
}
